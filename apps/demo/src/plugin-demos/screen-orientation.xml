<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
    <Page.actionBar>
        <ActionBar title="screen-orientation" icon="" class="action-bar">
        </ActionBar>
    </Page.actionBar>
    <StackLayout class="p-20">
        <ScrollView class="h-full">
          <StackLayout>
            <Button text="Orientacion" tap="{{ getOrientacion }}" class="btn btn-primary"/>
            <Button text="Change" tap="{{ changeOrientacion }}" class="btn btn-primary mt-10"/>
          </StackLayout>
        </ScrollView>
    </StackLayout>
</Page>
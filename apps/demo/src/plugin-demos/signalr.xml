<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
    <Page.actionBar>
        <ActionBar title="signalr" icon="" class="action-bar">
        </ActionBar>
    </Page.actionBar>
    <StackLayout class="p-20">
        <ScrollView class="h-full">
          <StackLayout>
            <Button text="Conectar" tap="{{ conectar }}" class="btn btn-primary"/>
            <Button text="Id" tap="{{ getID }}" class="btn btn-primary"/>
            <Button text="State" tap="{{ getState }}" class="btn btn-primary"/>
            <Button text="Stop" tap="{{ stop }}" class="btn btn-primary"/>
            <Button text="Invoke" tap="{{ invoke }}" class="btn btn-primary"/>
            <Button text="SetOn" tap="{{ setOn }}" class="btn btn-primary"/>

          </StackLayout>
        </ScrollView>
    </StackLayout>
</Page>
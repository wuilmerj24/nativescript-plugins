<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
    <Page.actionBar>
        <ActionBar title="launch-navigator" icon="" class="action-bar">
        </ActionBar>
    </Page.actionBar>
    <StackLayout class="p-20">
        <ScrollView class="h-full">
          <StackLayout>
            <Button text="Waze" tap="{{ launchWaze }}" class="btn btn-primary"/>
            <Button text="GoogleMaps" tap="{{ launchGoogle }}" class="btn btn-primary"/>
            <Button text="Uber" tap="{{ launchUber }}" class="btn btn-primary"/>
            <Button text="Select" tap="{{ launchNavigatorFN }}" class="btn btn-primary"/>

          </StackLayout>
        </ScrollView>
    </StackLayout>
</Page>
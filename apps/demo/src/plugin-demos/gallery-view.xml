<Page xmlns="http://schemas.nativescript.org/tns.xsd" xmlns:gv="@wuilmerj24/gallery-view" navigatingTo="navigatingTo" class="page">
    <Page.actionBar>
        <ActionBar title="gallery-view" icon="" class="action-bar">
        </ActionBar>
    </Page.actionBar>
    <StackLayout>
        <ScrollView orientation="horizontal"  width="100%" height="50%">
            <Repeater items="{{ imagenes }}">
                <Repeater.itemsLayout>
                    <StackLayout orientation="horizontal" />
                </Repeater.itemsLayout>
                <Repeater.itemTemplate>
                    <Image src="{{ $value.image }}" height="50%" margin="5" />
                </Repeater.itemTemplate>
            </Repeater>
        </ScrollView>
        <gv:GalleryView 
            width="100%" 
            height="50%" 
            debug="true" 
            language="es"
            bgColorHeader="green"
            textcolorHeader="red"
            maxItemSelect="15"
            bgColorFooter="blue"
            textColorFooter="green"
            preview="true"
            edit="true"
            colorRadio="blue"
            loaded="{{onLoad}}"
            errorEvent="{{onError}}"
            showFooter="true"
            scroll="{{onScroll}}"
            click="{{onClick}}"
        />
    </StackLayout>
</Page>